APP_ENV=development
PORT=8080
JWT_SECRET=change-this-to-a-strong-secret-key

# PostgreSQL Container Config
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tjus_db_dev

# Connection URLs (Inside Docker Compose network)
DB_URL=postgresql://postgres:postgres@db:5432/tjus_db_dev?sslmode=disable
REDIS_ADDR=redis:6379

