APP_ENV=development
PORT=8080
JWT_SECRET=your_super_secret_jwt_key_here

# PostgreSQL Container Config
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=your_db_name

# Connection URLs (Use host 'db' and 'redis' when running via Docker Compose)
DB_URL=postgresql://your_db_user:your_db_password@db:5432/your_db_name?sslmode=disable
REDIS_ADDR=redis:6379
